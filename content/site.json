  "protocol": {
    "groups": [
      {
        "name": "Before your appointment",
        "items": [
          {
            "text": "Book at least 4 weeks ahead of any big event — results settle, bruising fades."
          },
          {
            "text": "Skip blood thinners & NSAIDs (aspirin, ibuprofen, fish oil, vitamin E) for 2 weeks if you can."
          },
          {
            "text": "No alcohol for 24 hours and no smoking for 48 hours before treatment."
          },
          {
            "text": "Pause Retin-A two days before and after. No dental work within 4 weeks."
          },
          {
            "text": "Eat a good breakfast and arrive with a clean, makeup-free face."
          }
        ]
      },
      {
        "name": "After your treatment",
        "items": [
          {
            "text": "No workouts, yoga or massage for 24 hours — keep the product where we placed it."
          },
          {
            "text": "No alcohol for 24 hours, no smoking for 48; both slow healing and invite bruising."
          },
          {
            "text": "Prone to bruising? Arnica cream at the injection site helps."
          },
          {
            "text": "Cleanse gently — no harsh scrubs or aggressive rubbing."
          },
          {
            "text": "We see you again in 2 weeks. The follow-up is part of the treatment, and it's free."
          }
        ]
      }
    ]
  },
